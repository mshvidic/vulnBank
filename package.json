{
  "name": "vulnbank",
  "version": "1.0.0",
  "private": true,
  "description": "INTENTIONALLY VULNERABLE retail banking app for security training. Local use only.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:server\" \"npm:client\"",
    "server": "node --disable-warning=ExperimentalWarning server/index.js",
    "client": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:security": "playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
